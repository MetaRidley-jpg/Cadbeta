; Engine configuration file.
; Cadavire — Godot 4.7 project (PC + mobile, portrait).

config_version=5

[application]

config/name="Cadavire"
config/description="Bone idle tycoon with Cadavire."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07, 0.06, 0.08, 1)

[autoload]

Challenges="*res://scripts/challenges.gd"
Game="*res://scripts/game.gd"
Lines="*res://scripts/lines.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
